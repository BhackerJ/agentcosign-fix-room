# public (default): bundled model-driven browser shopper; probe: deterministic checks only.
# legacy: optional existing private harness; required only for reproducing historical driver behavior.
SHOPPER_MODE=public
# Visible browser for local verification; a challenge must be completed by the human.
SHOPPER_HEADLESS=false
# Optional local browser recording; keep raw authentication footage private.
SHOPPER_RECORD_VIDEO=false
